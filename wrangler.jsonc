{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drtimeless-ai-consult",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",

  // nodejs_compat 一定要開：呢個 app 用咗 node:os、Buffer、
  // 同埋 Anthropic SDK 入面嘅 Node API。
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": { "enabled": true },

  // 部署前解開呢塊，填返自己嘅值（點解要喺度而唔係 .env：見 DEPLOY.md ——
  // Workers 唔讀 .env，而 NEXT_PUBLIC_* 係 build 時烘入前端嘅，唔可以用 secret）
  // "vars": {
  //   "NEXT_PUBLIC_CLINIC_NAME": "Dr Timeless",
  //   "NEXT_PUBLIC_WHATSAPP": "852xxxxxxxx",
  //   "NEXT_PUBLIC_SITE_URL": "https://ai.drtimeless.com",
  //   "EMBED_ALLOWED_ORIGINS": "https://www.drtimeless.com,https://drtimeless.com",
  //   "RATE_LIMIT_DAILY_TOTAL": "300"
  // },

  // 客人紀錄資料庫（可選）。未建立 D1 之前留住註解 —— app 會自動用記憶體
  // 模式（唔會 crash），/records 會顯示「未接駁資料庫」警告。
  // 建立步驟見 DEPLOY.md「客人紀錄資料庫」一節。
  // "d1_databases": [
  //   { "binding": "VISITS_DB", "database_name": "drtimeless-visits", "database_id": "＜wrangler d1 create 出嚟嗰個 id＞" }
  // ],

  // 分析一次要等 Anthropic 回應 20–30 秒。喺 Workers，等 fetch 嘅時間
  // **唔計 CPU 時間**，所以呢個唔係問題 —— 但 CPU 上限仍然要調高少少，
  // 因為相片 base64 處理同 JSON 解析係實際 CPU。
  "limits": { "cpu_ms": 30000 }
}
