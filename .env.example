# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── 冇外國信用卡？可以改行 Claude Platform on AWS（帳單經 AWS，收香港卡）──
# 設埋下面兩個變數，個 app 就會轉用 AWS 通道；
# 嗰陣上面 ANTHROPIC_API_KEY 要改用 AWS Console
# （Claude Platform on AWS → API keys）出嗰條 key，唔係 console.anthropic.com 嗰條。
# model、請求格式、牌價全部不變。
# ANTHROPIC_AWS_WORKSPACE_ID=wrkspc_...
# ANTHROPIC_AWS_REGION=us-west-2

# 預設模型層級: budget | balanced | max
# budget   = claude-haiku-4-5   (最平，約 HK$0.05/次)
# balanced = claude-sonnet-5    (推薦，約 HK$0.20/次)
# max      = claude-opus-5      (最準，約 HK$0.55/次)
CONSULT_TIER=balanced

# 一致性投票次數 (1 = 單次；3 = 三次獨立分析取共識，準確度較高但成本 x3)
CONSULT_PASSES=1

# ── MVP 版（/）嘅診所資料 ──
# 呢兩個係 NEXT_PUBLIC_，會 build 入前端，唔好放敏感資料
NEXT_PUBLIC_CLINIC_NAME=你嘅診所名
# WhatsApp 號碼，國際格式冇 + 號（香港例：85212345678）
NEXT_PUBLIC_WHATSAPP=85212345678

# ── 測試模式 ──
# 設 DEMO_MODE=1 就唔會呼叫 AI、唔使 ANTHROPIC_API_KEY、零成本。
# 用預設示範數據行真嘅配對引擎，方便睇 UI、示範同做 UAT。
# 上線前記得移除。
DEMO_MODE=1

# ── 速率限制（保護 API 額度）──
RATE_LIMIT_PER_IP=5          # 每個 IP 每個時窗最多幾多次
RATE_LIMIT_WINDOW_SEC=3600   # 時窗長度（秒）
RATE_LIMIT_DAILY_TOTAL=500   # 全站每日上限 —— 呢個係「最壞情況蝕幾多」嘅硬保證

# ── 漏斗統計 ──
# 睇 /api/track?token=... 需要呢個。設一個長隨機字串。
FUNNEL_TOKEN=

# ── 分享預覽 ──
# 正式網址（含 https://）。唔填嘅話，WhatsApp / IG 分享時出唔到預覽卡同預覽圖。
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── 嵌入官網（www.drtimeless.com）──
# 邊啲網站可以用 iframe 載入 /embed。逗號分隔，要連 https://。
# ⚠️ 呢個係成本安全設定：唔設就冇外部網站嵌入得到（fail closed）。
#    容許全世界嵌入 = 任何人可以用你嘅 API 額度做佢哋生意，
#    而你唯一嘅線索係月尾張帳單。
# ⚠️ www 同冇 www 係兩個唔同 origin，兩個都要列。
EMBED_ALLOWED_ORIGINS=https://www.drtimeless.com,https://drtimeless.com

# ── 職員頁面保護（/pro、/share、/embed/setup）──
# 呢個工具一上網，所有路徑都係公開嘅。/pro 每撳一次都係你俾錢。
# 未設呢個 → 正式環境會拒絕開啟嗰幾版（測試模式照放行，方便試）。
# 用法：開 https://…/pro?k=你個密碼 一次，之後 30 日唔使再輸。
STAFF_TOKEN=
