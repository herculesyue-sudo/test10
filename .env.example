# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# 預設模型層級: budget | balanced | max
# budget   = claude-haiku-4-5   (最平，約 HK$0.05/次)
# balanced = claude-sonnet-5    (推薦，約 HK$0.20/次)
# max      = claude-opus-5      (最準，約 HK$0.55/次)
CONSULT_TIER=balanced

# 一致性投票次數 (1 = 單次；3 = 三次獨立分析取共識，準確度較高但成本 x3)
CONSULT_PASSES=1
